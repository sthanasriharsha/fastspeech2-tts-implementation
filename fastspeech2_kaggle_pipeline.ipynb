   "source": [
    "import os\n",
    "\n",
    "dirs = [\n",
    "    \"/kaggle/working/project/English/checkpoints\",\n",
    "    \"/kaggle/working/project/Telugu/checkpoints\",\n",
    "    \"/kaggle/working/project/Results/English/test_generated_audios\",\n",
    "    \"/kaggle/working/project/Results/English/variance_adaptor_plots/duration\",\n",
    "    \"/kaggle/working/project/Results/English/variance_adaptor_plots/pitch\",\n",
    "    \"/kaggle/working/project/Results/English/variance_adaptor_plots/energy\",\n",
    "    \"/kaggle/working/project/Results/Telugu/test_generated_audios\",\n",
    "    \"/kaggle/working/project/Results/Telugu/variance_adaptor_plots/duration\",\n",
    "    \"/kaggle/working/project/Results/Telugu/variance_adaptor_plots/pitch\",\n",
    "    \"/kaggle/working/project/Results/Telugu/variance_adaptor_plots/energy\",\n",
    "    \"/kaggle/working/project/Report\"\n",
    "]\n",
    "for d in dirs:\n",
