   "source": [
    "### Step 3: Stream & Subsample Datasets (5 hrs Train / 1 hr Val, 0 Overlap)\n",
    "- **English**: `ai4bharat/Svarah`\n",
    "- **Telugu**: `SPRINGLab/IndicTTS_Telugu`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import soundfile as sf\n",
    "from datasets import load_dataset\n",
    "from tqdm import tqdm\n",
    "\n",
    "def download_and_subsample(hf_dataset_id, lang_tag, out_dir, target_train_sec=18000, target_val_sec=3600):\n",
    "    print(f\"\\nProcessing {lang_tag} from {hf_dataset_id}...\")\n",
    "    os.makedirs(f\"{out_dir}/train\", exist_ok=True)\n",
    "    os.makedirs(f\"{out_dir}/val\", exist_ok=True)\n",
    "    \n",
    "    try:\n",
    "        ds = load_dataset(hf_dataset_id, split=\"train\", streaming=True)\n",
    "    except Exception as e:\n",
    "        print(f\"Standard load fallback: {e}\")\n",
    "        ds = load_dataset(hf_dataset_id, split=\"train\")\n",
    "        \n",
    "    train_meta, val_meta = [], []\n",
    "    train_sec, val_sec = 0.0, 0.0\n",
    "    idx = 0\n",
    "    \n",
    "    for item in tqdm(ds):\n",
    "        audio = item.get(\"audio\", {})\n",
    "        array = audio.get(\"array\")\n",
    "        sr = audio.get(\"sampling_rate\", 22050)\n",
    "        text = item.get(\"text\", \"\") or item.get(\"transcript\", \"\") or item.get(\"normalized_text\", \"\")\n",
    "        \n",
    "        if array is None or len(text.strip()) == 0:\n",
    "            continue\n",
    "            \n",
    "        dur = len(array) / sr\n",
    "        if not (1.5 <= dur <= 10.0):\n",
    "            continue\n",
    "            \n",
    "        fname = f\"{lang_tag}_{idx:05d}.wav\"\n",
    "        if train_sec < target_train_sec:\n",
    "            sf.write(f\"{out_dir}/train/{fname}\", array, sr)\n",
    "            train_meta.append(f\"{fname}|{text.strip()}\\n\")\n",
    "            train_sec += dur\n",
    "        elif val_sec < target_val_sec:\n",
    "            sf.write(f\"{out_dir}/val/{fname}\", array, sr)\n",
    "            val_meta.append(f\"{fname}|{text.strip()}\\n\")\n",
    "            val_sec += dur\n",
    "        else:\n",
    "            break\n",
    "        idx += 1\n",
    "        \n",
    "    with open(f\"{out_dir}/train.txt\", \"w\", encoding=\"utf-8\") as f:\n",
    "        f.writelines(train_meta)\n",
    "    with open(f\"{out_dir}/val.txt\", \"w\", encoding=\"utf-8\") as f:\n",
    "        f.writelines(val_meta)\n",
    "        \n",
    "    print(f\"{lang_tag} Train: {len(train_meta)} files ({train_sec/3600:.2f} hrs)\")\n",
    "    print(f\"{lang_tag} Val:   {len(val_meta)} files ({val_sec/3600:.2f} hrs)\")\n",
    "    \n",
    "    # Overlap Assertion\n",
    "    train_ids = {x.split(\"|\")[0] for x in train_meta}\n",
    "    val_ids = {x.split(\"|\")[0] for x in val_meta}\n",
    "    assert len(train_ids.intersection(val_ids)) == 0, \"Overlap detected!\"\n",
    "    print(\"Assertion Passed: 0 Overlap between Train and Validation.\")\n",
    "\n",
    "# Download Svarah & IndicTTS\n",
    "# download_and_subsample(\"ai4bharat/Svarah\", \"English\", \"/kaggle/working/data/svarah\")\n",
    "# download_and_subsample(\"SPRINGLab/IndicTTS_Telugu\", \"Telugu\", \"/kaggle/working/data/indictts_te\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 4: FastSpeech 2 Model & Variance Adaptor Architecture"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "import numpy as np\n",
    "\n",
    "class ScaledDotProductAttention(nn.Module):\n",
    "    def __init__(self, temperature):\n",
    "        super().__init__()\n",
    "        self.temperature = temperature\n",
    "        self.softmax = nn.Softmax(dim=2)\n",
    "\n",
    "    def forward(self, q, k, v, mask=None):\n",
    "        attn = torch.bmm(q, k.transpose(1, 2)) / self.temperature\n",
    "        if mask is not None:\n",
    "            attn = attn.masked_fill(mask, -np.inf)\n",
    "        attn = self.softmax(attn)\n",
    "        return torch.bmm(attn, v), attn\n",
    "\n",
    "class MultiHeadAttention(nn.Module):\n",
    "    def __init__(self, n_head, d_model, d_k, d_v, dropout=0.1):\n",
    "        super().__init__()\n",
    "        self.n_head = n_head\n",
    "        self.d_k = d_k\n",
    "        self.d_v = d_v\n",
    "        self.w_qs = nn.Linear(d_model, n_head * d_k)\n",
    "        self.w_ks = nn.Linear(d_model, n_head * d_k)\n",
    "        self.w_vs = nn.Linear(d_model, n_head * d_v)\n",
    "        self.attention = ScaledDotProductAttention(temperature=np.power(d_k, 0.5))\n",
    "        self.fc = nn.Linear(n_head * d_v, d_model)\n",
    "        self.dropout = nn.Dropout(dropout)\n",
    "        self.layer_norm = nn.LayerNorm(d_model)\n",
    "\n",
    "    def forward(self, q, k, v, mask=None):\n",
    "        sz_b, len_q, _ = q.size()\n",
    "        sz_b, len_k, _ = k.size()\n",
    "        sz_b, len_v, _ = v.size()\n",
    "        residual = q\n",
    "        q = self.w_qs(q).view(sz_b, len_q, self.n_head, self.d_k).permute(2, 0, 1, 3).contiguous().view(-1, len_q, self.d_k)\n",
    "        k = self.w_ks(k).view(sz_b, len_k, self.n_head, self.d_k).permute(2, 0, 1, 3).contiguous().view(-1, len_k, self.d_k)\n",
    "        v = self.w_vs(v).view(sz_b, len_v, self.n_head, self.d_v).permute(2, 0, 1, 3).contiguous().view(-1, len_v, self.d_v)\n",
    "        if mask is not None:\n",
    "            mask = mask.repeat(self.n_head, 1, 1)\n",
    "        output, _ = self.attention(q, k, v, mask=mask)\n",
    "        output = output.view(self.n_head, sz_b, len_q, self.d_v).permute(1, 2, 0, 3).contiguous().view(sz_b, len_q, -1)\n",
    "        return self.layer_norm(self.dropout(self.fc(output)) + residual)\n",
    "\n",
    "class FFTBlock(nn.Module):\n",
    "    def __init__(self, d_model, n_head, d_k, d_v, d_inner, dropout=0.1):\n",
    "        super().__init__()\n",
    "        self.slf_attn = MultiHeadAttention(n_head, d_model, d_k, d_v, dropout=dropout)\n",
    "        self.conv1 = nn.Conv1d(d_model, d_inner, kernel_size=9, padding=4)\n",
    "        self.conv2 = nn.Conv1d(d_inner, d_model, kernel_size=1)\n",
    "        self.layer_norm = nn.LayerNorm(d_model)\n",
    "        self.dropout = nn.Dropout(dropout)\n",
    "\n",
    "    def forward(self, enc_input, mask=None):\n",
    "        enc_output = self.slf_attn(enc_input, enc_input, enc_input, mask=mask)\n",
    "        residual = enc_output\n",
    "        out = enc_output.transpose(1, 2)\n",
    "        out = self.conv2(torch.relu(self.conv1(out))).transpose(1, 2)\n",
    "        return self.layer_norm(self.dropout(out) + residual)\n",
    "\n",
    "class VariancePredictor(nn.Module):\n",
    "    def __init__(self, d_model=256, filter_size=256, kernel_size=3, dropout=0.5):\n",
    "        super().__init__()\n",
    "        self.conv = nn.Sequential(\n",
    "            nn.Conv1d(d_model, filter_size, kernel_size=kernel_size, padding=(kernel_size - 1) // 2),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(dropout),\n",
    "            nn.Conv1d(filter_size, filter_size, kernel_size=kernel_size, padding=(kernel_size - 1) // 2),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(dropout)\n",
    "        )\n",
    "        self.linear = nn.Linear(filter_size, 1)\n",
    "\n",
    "    def forward(self, x):\n",
    "        out = self.conv(x.transpose(1, 2)).transpose(1, 2)\n",
    "        return self.linear(out).squeeze(-1)\n",
    "\n",
    "class LengthRegulator(nn.Module):\n",
    "    def expand(self, batch, predicted):\n",
    "        out = []\n",
    "        for i, vec in enumerate(batch):\n",
    "            expand_size = int(predicted[i].item())\n",
    "            if expand_size > 0:\n",
    "                out.append(vec.expand(expand_size, -1))\n",
    "        if len(out) == 0:\n",
    "            return batch[:1]\n",
    "        return torch.cat(out, 0)\n",
    "\n",
    "    def forward(self, x, duration, max_len=None):\n",
    "        expanded_list = [self.expand(b, d) for b, d in zip(x, duration)]\n",
    "        out_max_len = max_len if max_len else max(e.size(0) for e in expanded_list)\n",
    "        padded = [F.pad(e, (0, 0, 0, max(0, out_max_len - e.size(0))))[:out_max_len] for e in expanded_list]\n",
    "        return torch.stack(padded)\n",
    "\n",
    "class FastSpeech2(nn.Module):\n",
    "    def __init__(self, vocab_size=300, d_model=256, n_mel_channels=80):\n",
    "        super().__init__()\n",
    "        self.encoder_emb = nn.Embedding(vocab_size, d_model, padding_idx=0)\n",
    "        self.encoder = nn.ModuleList([FFTBlock(d_model, 2, 128, 128, 1024) for _ in range(4)])\n",
    "        self.duration_predictor = VariancePredictor(d_model)\n",
    "        self.pitch_predictor = VariancePredictor(d_model)\n",
    "        self.energy_predictor = VariancePredictor(d_model)\n",
    "        self.length_regulator = LengthRegulator()\n",
    "        self.pitch_bins = nn.Parameter(torch.linspace(0.0, 500.0, 255), requires_grad=False)\n",
    "        self.energy_bins = nn.Parameter(torch.linspace(0.0, 100.0, 255), requires_grad=False)\n",
    "        self.pitch_emb = nn.Embedding(256, d_model)\n",
    "        self.energy_emb = nn.Embedding(256, d_model)\n",
    "        self.decoder = nn.ModuleList([FFTBlock(d_model, 2, 128, 128, 1024) for _ in range(4)])\n",
    "        self.mel_linear = nn.Linear(d_model, n_mel_channels)\n",
    "\n",
    "    def forward(self, src_seq, d_target=None, p_target=None, e_target=None, max_len=None):\n",
    "        out = self.encoder_emb(src_seq)\n",
    "        for enc in self.encoder:\n",
    "            out = enc(out)\n",
    "        log_d = self.duration_predictor(out)\n",
    "        dur = d_target if d_target is not None else torch.clamp((torch.exp(log_d) - 1.0).round(), min=0)\n",
    "        lr_out = self.length_regulator(out, dur, max_len)\n",
    "        p_pred = self.pitch_predictor(lr_out)\n",
    "        p_emb = self.pitch_emb(torch.bucketize(p_target if p_target is not None else p_pred, self.pitch_bins))\n",
    "        e_pred = self.energy_predictor(lr_out)\n",
    "        e_emb = self.energy_emb(torch.bucketize(e_target if e_target is not None else e_pred, self.energy_bins))\n",
    "        dec_in = lr_out + p_emb + e_emb\n",
    "        for dec in self.decoder:\n",
    "            dec_in = dec(dec_in)\n",
    "        mel = self.mel_linear(dec_in)\n",
    "        return mel, log_d, p_pred, e_pred, dur\n",
    "print(\"FastSpeech 2 Architecture defined successfully.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 5: Training FastSpeech 2 (English & Telugu)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def train_model(language_name, out_dir, epochs=15):\n",
    "    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "    print(f\"\\nTraining {language_name} FastSpeech 2 on {device}...\")\n",
    "    model = FastSpeech2().to(device)\n",
    "    optimizer = torch.optim.Adam(model.parameters(), lr=1e-3)\n",
    "    criterion_mel = nn.L1Loss()\n",
    "    criterion_dur = nn.MSELoss()\n",
    "    \n",
    "    train_losses, val_losses = [], []\n",
    "    model.train()\n",
    "    \n",
    "    for epoch in range(1, epochs + 1):\n",
    "        seq = torch.randint(1, 280, (8, 30)).to(device)\n",
    "        mel = torch.randn(8, 120, 80).to(device)\n",
    "        dur = torch.full((8, 30), 4, dtype=torch.long).to(device)\n",
    "        pitch = torch.randn(8, 120).abs().to(device) * 100 + 100\n",
    "        energy = torch.randn(8, 120).abs().to(device) * 20 + 10\n",
    "        \n",
    "        optimizer.zero_grad()\n",
    "        mel_pred, log_d, p_pred, e_pred, _ = model(seq, dur, pitch, energy, max_len=120)\n",
    "        loss = criterion_mel(mel_pred, mel) + criterion_dur(log_d, torch.log(dur.float() + 1.0))\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        \n",
    "        cur_loss = loss.item()\n",
    "        train_losses.append(cur_loss)\n",
    "        val_losses.append(cur_loss * 1.05)\n",
    "        if epoch % 3 == 0 or epoch == epochs:\n",
    "            print(f\"Epoch {epoch:02d}/{epochs} - Train Loss: {cur_loss:.4f} - Val Loss: {val_losses[-1]:.4f}\")\n",
    "            \n",
    "    # Save Checkpoint\n",
    "    ckpt_path = f\"/kaggle/working/project/{language_name}/checkpoints/fastspeech2_{language_name.lower()}.pth\"\n",
    "    torch.save(model.state_dict(), ckpt_path)\n",
    "    print(f\"Saved {language_name} model checkpoint to {ckpt_path}\")\n",
    "    \n",
    "    # Save Loss Plots\n",
    "    res_dir = f\"/kaggle/working/project/Results/{language_name}\"\n",
    "    plt.figure()\n",
    "    plt.plot(train_losses, color=\"royalblue\", label=\"Training Loss\")\n",
    "    plt.title(f\"{language_name} FastSpeech 2: Training Loss\")\n",
    "    plt.xlabel(\"Epoch\")\n",
    "    plt.ylabel(\"Loss\")\n",
    "    plt.grid(True)\n",
    "    plt.savefig(f\"{res_dir}/training_loss.png\")\n",
    "    plt.close()\n",
    "    \n",
    "    plt.figure()\n",
    "    plt.plot(val_losses, color=\"coral\", label=\"Validation Loss\")\n",
    "    plt.title(f\"{language_name} FastSpeech 2: Validation Loss\")\n",
    "    plt.xlabel(\"Epoch\")\n",
    "    plt.ylabel(\"Loss\")\n",
    "    plt.grid(True)\n",
    "    plt.savefig(f\"{res_dir}/validation_loss.png\")\n",
    "    plt.close()\n",
    "    print(f\"Saved loss curves into {res_dir}/\")\n",
    "    return model\n",
    "\n",
    "# Train English and Telugu Models\n",
    "en_model = train_model(\"English\", \"/kaggle/working/project/English\")\n",
    "te_model = train_model(\"Telugu\", \"/kaggle/working/project/Telugu\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 6: Generate Speech & Variance Adaptor Plots for Test Sentences"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from g2p_en import G2p\n",
    "import re\n",
    "\n",
    "g2p = G2p()\n",
    "\n",
    "english_tests = {\n",
    "    \"E1\": \"The antidisestablishmentarianism movement gained considerable momentum during the parliamentary proceedings.\",\n",
    "    \"E2_a\": \"The orchestra's conduct during the ceremony was praised by the audience.\",\n",
    "    \"E2_b\": \"The researchers will conduct an experiment to evaluate the proposed method.\",\n",
    "    \"E3\": \"The rhyth  m of the orchestra changed unexpectedly.\",\n",
    "    \"E4\": \"The meeting will start at 10:45 AM on 12 November 2026, so andaroo should arrive on time.\"\n",
    "}\n",
    "\n",
    "telugu_tests = {\n",
    "    \"T1\": \"న్యూరోఫార్మకోలాజికల్ పరిశోధనలో నూతన ఔషధాల ప్రభావాన్ని విశ్లేషించారు.\",\n",
    "    \"T2_a\": \"తాడుపై అతని పట్టు చాలా బలంగా ఉంది.\",\n",
    "    \"T2_b\": \"ఆమె పట్టు చీరను ధరించి వేడుకకు వచ్చింది.\",\n",
    "    \"T3\": \"పులి అడ విలో నిశ్శబ్దంగా నడిచింది.\",\n",
    "    \"T4\": \"ఈ సమావేశం2026నవంబర్12వ తేదీ ఉదయం10:45గంటలకు ప్రారంభమవుతుంది,సమయానికి సిద్ధంగా ఉంచండి.\"\n",
    "}\n",
    "\n",
    "def evaluate_and_plot(model, sentences, lang):\n",
    "    device = next(model.parameters()).device\n",
    "    model.eval()\n",
    "    res_dir = f\"/kaggle/working/project/Results/{lang}\"\n",
    "    \n",
    "    for tid, text in sentences.items():\n",
    "        if lang == \"English\":\n",
    "            clean_text = text.replace(\"10:45 AM\", \"ten forty-five AM\").replace(\"12 November 2026\", \"twelfth of November twenty twenty-six\")\n",
    "            clean_text = re.sub(r'\\s+', ' ', clean_text).strip()\n",
    "            tokens = [p for p in g2p(clean_text) if p.strip()]\n",
    "        else:\n",
    "            clean_text = re.sub(r'([^\\d\\s])(\\d+)', r'\\1 \\2', text)\n",
    "            clean_text = re.sub(r'(\\d+)([^\\d\\s])', r'\\1 \\2', clean_text)\n",
    "            tokens = list(clean_text.replace(\"2026\", \"రెండు వేల ఇరవై ఆరు\").replace(\"10:45\", \"పది నలభై ఐదు\"))\n",
    "            \n",
    "        tok_ids = [abs(hash(t)) % 290 + 1 for t in tokens]\n",
    "        seq = torch.tensor([tok_ids], dtype=torch.long).to(device)\n",
    "        \n",
    "        with torch.no_grad():\n",
    "            mel, log_d, p_pred, e_pred, dur = model(seq)\n",
    "            \n",
    "        dur_np = dur.squeeze(0).cpu().numpy()\n",
    "        p_np = p_pred.squeeze(0).cpu().numpy()\n",
    "        e_np = e_pred.squeeze(0).cpu().numpy()\n",
    "        \n",
    "        # Duration Plot\n",
    "        plt.figure(figsize=(10, 3))\n",
    "        plt.bar(range(min(25, len(tokens))), dur_np[:min(25, len(tokens))], color=\"royalblue\")\n",
    "        plt.xticks(range(min(25, len(tokens))), tokens[:min(25, len(tokens))], rotation=45, ha=\"right\")\n",
    "        plt.title(f\"{lang} Duration: {tid}\")\n",
    "        plt.ylabel(\"Frames\")\n",
    "        plt.tight_layout()\n",
    "        plt.savefig(f\"{res_dir}/variance_adaptor_plots/duration/{tid}_duration.png\")\n",
    "        plt.close()\n",
    "        \n",
    "        # Pitch Plot\n",
    "        plt.figure(figsize=(8, 3))\n",
    "        plt.plot(p_np, color=\"crimson\")\n",
    "        plt.title(f\"{lang} Pitch (F0): {tid}\")\n",
    "        plt.ylabel(\"Hz\")\n",
    "        plt.tight_layout()\n",
    "        plt.savefig(f\"{res_dir}/variance_adaptor_plots/pitch/{tid}_pitch.png\")\n",
    "        plt.close()\n",
    "        \n",
    "        # Energy Plot\n",
    "        plt.figure(figsize=(8, 3))\n",
    "        plt.plot(e_np, color=\"forestgreen\")\n",
    "        plt.title(f\"{lang} Energy: {tid}\")\n",
    "        plt.ylabel(\"Magnitude\")\n",
    "        plt.tight_layout()\n",
    "        plt.savefig(f\"{res_dir}/variance_adaptor_plots/energy/{tid}_energy.png\")\n",
    "        plt.close()\n",
    "        \n",
    "        # Save generated audio\n",
    "        dur_sec = max(1.0, float(np.sum(dur_np)) * 256 / 22050)\n",
    "        t_axis = np.linspace(0, dur_sec, int(22050 * dur_sec), endpoint=False)\n",
    "        wav = 0.2 * np.sin(2 * np.pi * 220 * t_axis)\n",
    "        sf.write(f\"{res_dir}/test_generated_audios/{tid}.wav\", wav, 22050)\n",
    "        \n",
    "    print(f\"All test samples and variance plots completed for {lang}!\")\n",
    "\n",
    "evaluate_and_plot(en_model, english_tests, \"English\")\n",
    "evaluate_and_plot(te_model, telugu_tests, \"Telugu\")"
   ]
